##############################################################
# PhishGuard — Environment Variables Template
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# NEVER commit .env to version control.
# Author: Akshay | https://akshay.fruvvi.com
##############################################################

# ── App ───────────────────────────────────────────────────────
ENVIRONMENT=development
# Options: development | production | test

LOG_LEVEL=INFO
# Options: DEBUG | INFO | WARNING | ERROR

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In production, set this to your extension's chrome-extension:// URL.
# Find it at chrome://extensions after loading the extension.
CORS_ORIGINS=chrome-extension://,moz-extension://

# ── Security ─────────────────────────────────────────────────
ALLOWED_HOSTS=localhost,127.0.0.1
# In production: ALLOWED_HOSTS=api.yourdomain.com

# Rate limiting (requests per minute per IP)
RATE_LIMIT_RPM=60

# ── External APIs ────────────────────────────────────────────

# PhishTank API Key (optional — improves rate limits)
# Register free at: https://www.phishtank.com/api_info.php
PHISHTANK_API_KEY=

# ── Feature Flags ────────────────────────────────────────────
ENABLE_URLHAUS=true
ENABLE_PHISHTANK=true

# ── Cache ────────────────────────────────────────────────────
# Seconds to cache threat intel results server-side
THREAT_CACHE_TTL=3600
